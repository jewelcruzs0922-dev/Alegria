<style>
  #shopify-section-{{ section.id }} .alegria-password {
    position: relative;
    display: grid;
    align-items: center;
    min-height: calc(100vh - 18rem);
    overflow: hidden;
    color: #f5f1ea;
  }
  #shopify-section-{{ section.id }} .alegria-password__media,
  #shopify-section-{{ section.id }} .alegria-password__media img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  #shopify-section-{{ section.id }} .alegria-password__media {
    background-color: var(--alegria-charcoal);
  }
  #shopify-section-{{ section.id }} .alegria-password__scrim {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 120% at 30% 50%, rgba(20, 18, 16, 0.72) 0%, rgba(20, 18, 16, 0.92) 70%),
      linear-gradient(180deg, rgba(20, 18, 16, 0.7) 0%, rgba(20, 18, 16, 0.82) 100%);
  }
  #shopify-section-{{ section.id }} .alegria-password__inner {
    position: relative;
    z-index: 2;
    width: 100%;
    max-width: 62rem;
    margin: 0 auto;
    padding: clamp(4rem, 8vw, 8rem) 2rem;
    text-align: center;
  }
  #shopify-section-{{ section.id }} .alegria-password__eyebrow {
    color: var(--alegria-gold);
    margin-bottom: 2rem;
  }
  #shopify-section-{{ section.id }} .alegria-password__heading {
    font-size: clamp(3.4rem, 5.4vw, 6rem);
    line-height: 1.05;
    margin: 0 0 2rem;
    color: #f5f1ea;
  }
  #shopify-section-{{ section.id }} .alegria-password__text {
    font-size: 1.7rem;
    line-height: 1.7;
    color: rgba(245, 241, 234, 0.84);
    margin: 0 auto 3.2rem;
    max-width: 46ch;
  }
  #shopify-section-{{ section.id }} .alegria-password__form {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
  }
  #shopify-section-{{ section.id }} .alegria-password__field {
    flex: 1 1 28rem;
    min-width: 0;
  }
  #shopify-section-{{ section.id }} .alegria-password__input {
    width: 100%;
    padding: 1.6rem 1.8rem;
    font-size: 1.5rem;
    color: #f5f1ea;
    background: rgba(245, 241, 234, 0.08);
    border: 1px solid rgba(245, 241, 234, 0.35);
    border-radius: 2px;
  }
  #shopify-section-{{ section.id }} .alegria-password__input::placeholder {
    color: rgba(245, 241, 234, 0.6);
  }
  #shopify-section-{{ section.id }} .alegria-password__submit {
    background: var(--alegria-crimson);
    border: 1px solid var(--alegria-crimson);
    color: #ffffff;
    padding: 1.6rem 3.4rem;
    font-size: 1.3rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    border-radius: 2px;
    cursor: pointer;
    transition: background-color 0.25s ease, border-color 0.25s ease, color 0.25s ease;
  }
  #shopify-section-{{ section.id }} .alegria-password__submit:hover {
    background: var(--alegria-gold);
    border-color: var(--alegria-gold);
    color: var(--alegria-charcoal);
  }
  #shopify-section-{{ section.id }} .alegria-password__message {
    margin-top: 2rem;
    font-size: 1.5rem;
  }
  #shopify-section-{{ section.id }} .alegria-password__message--success { color: var(--alegria-gold); }
  #shopify-section-{{ section.id }} .alegria-password__message--error { color: #ff9a9a; }
  #shopify-section-{{ section.id }} .alegria-password__hint {
    margin-top: 3rem;
    font-size: 1.3rem;
    letter-spacing: 0.04em;
    color: rgba(245, 241, 234, 0.62);
  }
</style>

<div class="alegria-password">
  <div class="alegria-password__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 2400
        | image_tag:
          loading: 'eager',
          fetchpriority: 'high',
          widths: '750, 1100, 1500, 2000, 2400',
          sizes: '100vw',
          alt: section.settings.image.alt | default: shop.name
      }}
    {%- else -%}
      {{ 'lifestyle-1' | placeholder_svg_tag: 'alegria-password__placeholder' }}
    {%- endif -%}
  </div>
  <span class="alegria-password__scrim" aria-hidden="true"></span>

  <div class="alegria-password__inner">
    {%- if section.settings.eyebrow != blank -%}
      <span class="alegria-eyebrow alegria-password__eyebrow">{{ section.settings.eyebrow }}</span>
    {%- endif -%}
    <h1 class="alegria-password__heading">{{ section.settings.heading }}</h1>
    {%- if section.settings.text != blank -%}
      <div class="alegria-password__text">{{ section.settings.text }}</div>
    {%- endif -%}

    {%- form 'customer', class: 'alegria-password__form-el' -%}
      <input type="hidden" name="contact[tags]" value="prospect, password page">
      <div class="alegria-password__form">
        <div class="alegria-password__field">
          <label class="visually-hidden" for="Password-email-{{ section.id }}">Email address</label>
          <input
            id="Password-email-{{ section.id }}"
            class="alegria-password__input"
            type="email"
            name="contact[email]"
            autocomplete="email"
            placeholder="Email address"
            required
          >
        </div>
        <button type="submit" class="alegria-password__submit">{{ section.settings.button_label }}</button>
      </div>

      {%- if form.posted_successfully? -%}
        <p class="alegria-password__message alegria-password__message--success" role="status">
          {{ section.settings.success_message }}
        </p>
      {%- elsif form.errors -%}
        <p class="alegria-password__message alegria-password__message--error" role="status">
          {{ form.errors | default_errors }}
        </p>
      {%- endif -%}
    {%- endform -%}

    {%- if section.settings.hint != blank -%}
      <p class="alegria-password__hint">{{ section.settings.hint }}</p>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Alegria password",
  "tag": "section",
  "class": "section-alegria-password",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Alegria — opening soon" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Considered furniture, made slowly" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>We're putting the finishing touches to the store. Leave your email and we'll let you know the moment we open.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Notify me" },
    { "type": "text", "id": "success_message", "label": "Success message", "default": "Thank you — we'll be in touch soon." },
    { "type": "text", "id": "hint", "label": "Hint", "default": "Already have the password? Open the padlock in the header to come inside." }
  ],
  "presets": [
    { "name": "Alegria password" }
  ]
}
{% endschema %}
