<style>
  #shopify-section-{{ section.id }} .alegria-more {
    padding: var(--alegria-space-section) 0;
    border-top: 1px solid var(--alegria-line);
  }
  #shopify-section-{{ section.id }} .alegria-more__head {
    margin-bottom: clamp(3rem, 5vw, 4.6rem);
  }
  #shopify-section-{{ section.id }} .alegria-more__head h2 {
    font-size: clamp(2.8rem, 4vw, 4.4rem);
    margin: 0;
  }
  #shopify-section-{{ section.id }} .alegria-more__grid {
    display: grid;
    gap: 2.4rem;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .alegria-more__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  #shopify-section-{{ section.id }} .alegria-post {
    display: flex;
    flex-direction: column;
    color: inherit;
    text-decoration: none;
  }
  #shopify-section-{{ section.id }} .alegria-post__media {
    overflow: hidden;
    border-radius: 2px;
    aspect-ratio: 4 / 3;
    background: rgba(var(--color-foreground), 0.06);
  }
  #shopify-section-{{ section.id }} .alegria-post__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }
  #shopify-section-{{ section.id }} .alegria-post:hover .alegria-post__media img {
    transform: scale(1.04);
  }
  #shopify-section-{{ section.id }} .alegria-post__meta {
    font-size: 1.2rem;
    letter-spacing: var(--alegria-tracking-wide);
    text-transform: uppercase;
    color: var(--alegria-gold);
    margin: 1.8rem 0 1rem;
  }
  #shopify-section-{{ section.id }} .alegria-post__title {
    font-family: var(--font-heading-family);
    font-size: 2.1rem;
    line-height: 1.25;
    margin: 0 0 1rem;
  }
  #shopify-section-{{ section.id }} .alegria-post:hover .alegria-post__title {
    color: var(--alegria-gold);
  }
  #shopify-section-{{ section.id }} .alegria-post__excerpt {
    font-size: 1.5rem;
    line-height: 1.65;
    color: rgba(var(--color-foreground), 0.78);
    margin: 0;
  }
</style>

<div class="alegria-more color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="alegria-more__head">
      {%- if section.settings.eyebrow != blank -%}
        <span class="alegria-eyebrow">{{ section.settings.eyebrow }}</span>
      {%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
    </div>

    <div class="alegria-more__grid">
      {%- assign current = article.handle -%}
      {%- assign shown = 0 -%}
      {%- for a in blog.articles -%}
        {%- if a.handle != current and shown < section.settings.posts_to_show -%}
          {%- assign shown = shown | plus: 1 -%}
          <a class="alegria-post" href="{{ a.url }}">
            <div class="alegria-post__media">
              {%- if a.image -%}
                {{
                  a.image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 450, 600, 900',
                    sizes: '(min-width: 750px) 33vw, 100vw',
                    alt: a.image.alt | default: a.title
                }}
              {%- endif -%}
            </div>
            <p class="alegria-post__meta">{{ a.published_at | date: '%b %d, %Y' }}</p>
            <p class="alegria-post__title">{{ a.title }}</p>
            <p class="alegria-post__excerpt">{{ a.excerpt_or_content | strip_html | truncatewords: 20 }}</p>
          </a>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Alegria more articles",
  "tag": "section",
  "class": "section-alegria-more",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Keep reading" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "More from the Journal" },
    { "type": "range", "id": "posts_to_show", "label": "Articles to show", "min": 1, "max": 3, "step": 1, "default": 3 },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [
    { "name": "Alegria more articles" }
  ]
}
{% endschema %}
