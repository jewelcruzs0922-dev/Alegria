<style>
  #shopify-section-{{ section.id }} .alegria-values {
    padding: var(--alegria-space-section) 0;
  }
  #shopify-section-{{ section.id }} .alegria-values__head {
    max-width: 60rem;
    margin: 0 auto clamp(3.4rem, 5vw, 5.6rem);
    text-align: center;
  }
  #shopify-section-{{ section.id }} .alegria-values__head h2 {
    font-size: clamp(3rem, 4.4vw, 4.8rem);
    margin: 0 0 1.6rem;
  }
  #shopify-section-{{ section.id }} .alegria-values__intro {
    font-size: 1.6rem;
    line-height: 1.7;
    color: rgba(var(--color-foreground), 0.8);
    margin: 0;
  }
  #shopify-section-{{ section.id }} .alegria-values__grid {
    display: grid;
    gap: clamp(2.8rem, 4vw, 4.4rem);
    grid-template-columns: 1fr;
  }
  @media screen and (min-width: 700px) {
    #shopify-section-{{ section.id }} .alegria-values__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .alegria-values__grid {
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    }
  }
  #shopify-section-{{ section.id }} .alegria-value {
    text-align: center;
    padding: 0 1rem;
  }
  #shopify-section-{{ section.id }} .alegria-value__icon {
    width: 5.6rem;
    height: 5.6rem;
    margin: 0 auto 2rem;
    display: grid;
    place-items: center;
    border: 1px solid var(--alegria-gold);
    border-radius: 50%;
    color: var(--alegria-gold);
  }
  #shopify-section-{{ section.id }} .alegria-value__icon svg {
    width: 2.4rem;
    height: 2.4rem;
  }
  #shopify-section-{{ section.id }} .alegria-value__title {
    font-family: var(--font-heading-family);
    font-size: 2rem;
    margin: 0 0 1rem;
  }
  #shopify-section-{{ section.id }} .alegria-value__text {
    font-size: 1.5rem;
    line-height: 1.65;
    color: rgba(var(--color-foreground), 0.78);
    margin: 0;
  }
  .color-scheme-2 #shopify-section-{{ section.id }} .alegria-value__text,
  .color-scheme-3 #shopify-section-{{ section.id }} .alegria-value__text {
    color: rgba(255, 255, 255, 0.92);
  }
</style>

<div class="alegria-values color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    {%- if section.settings.eyebrow != blank or section.settings.heading != blank -%}
      <div class="alegria-values__head">
        {%- if section.settings.eyebrow != blank -%}
          <span class="alegria-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.intro != blank -%}
          <p class="alegria-values__intro">{{ section.settings.intro }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="alegria-values__grid">
      {%- for block in section.blocks -%}
        <div class="alegria-value" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != 'none' -%}
            <span class="alegria-value__icon" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'leaf' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6"/></svg>
                {%- when 'tool' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>
                {%- when 'truck' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M1 3h15v13H1z"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                {%- when 'shield' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                {%- when 'globe' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
                {%- when 'award' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"/><path d="M8.21 13.89 7 23l5-3 5 3-1.21-9.12"/></svg>
                {%- when 'sparkle' -%}
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2l1.9 5.8L20 9.7l-5.8 1.9L12 17.4l-1.9-5.8L4 9.7l6.1-1.9z"/></svg>
              {%- endcase -%}
            </span>
          {%- endif -%}
          <h3 class="alegria-value__title">{{ block.settings.title }}</h3>
          {%- if block.settings.text != blank -%}
            <p class="alegria-value__text">{{ block.settings.text }}</p>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Alegria values",
  "tag": "section",
  "class": "section-alegria-values",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Alegria" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Furniture worth keeping" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Four promises that shape everything we make — from the timber we choose to the way it arrives at your door." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "leaf", "label": "Leaf" },
            { "value": "tool", "label": "Tool" },
            { "value": "truck", "label": "Delivery" },
            { "value": "shield", "label": "Shield" },
            { "value": "globe", "label": "Globe" },
            { "value": "award", "label": "Award" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "none", "label": "None" }
          ],
          "default": "leaf"
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Natural materials" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Solid oak, walnut, stone, wool and brass — chosen for how they age." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Alegria values",
      "blocks": [
        { "type": "value" },
        { "type": "value" },
        { "type": "value" },
        { "type": "value" }
      ]
    }
  ]
}
{% endschema %}
