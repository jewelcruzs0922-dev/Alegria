{%- liquid
  assign reverse = false
  if section.settings.image_position == 'right'
    assign reverse = true
  endif
-%}

<style>
  #shopify-section-{{ section.id }} .alegria-editorial-wrap {
    padding: var(--alegria-space-section) 0;
  }
  #shopify-section-{{ section.id }} .alegria-editorial__body h2 {
    margin: 0 0 1.8rem;
  }
  #shopify-section-{{ section.id }} .alegria-editorial__media {
    overflow: hidden;
  }
  #shopify-section-{{ section.id }} .alegria-editorial__media img,
  #shopify-section-{{ section.id }} .alegria-editorial__media svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    aspect-ratio: 4 / 5;
  }
  #shopify-section-{{ section.id }} .alegria-editorial--reverse .alegria-editorial__media {
    order: 2;
  }
</style>

<div class="alegria-editorial-wrap color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="alegria-editorial alegria-editorial--split{% if reverse %} alegria-editorial--reverse{% endif %}">
      <div class="alegria-editorial__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 2000
            | image_tag:
              loading: 'lazy',
              widths: '500, 750, 1000, 1500, 2000',
              sizes: '(min-width: 900px) 50vw, 100vw',
              alt: section.settings.image.alt | default: section.settings.heading
          }}
        {%- else -%}
          {{ 'lifestyle-2' | placeholder_svg_tag: 'alegria-editorial__placeholder' }}
        {%- endif -%}
      </div>

      <div class="alegria-editorial__body">
        {%- if section.settings.eyebrow != blank -%}
          <span class="alegria-eyebrow alegria-editorial__eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}

        {%- if section.settings.heading != blank -%}
          <h2>{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="rte">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.settings.link_label != blank and section.settings.link != blank -%}
          <a class="alegria-editorial__link" href="{{ section.settings.link }}">{{ section.settings.link_label }}</a>
        {%- endif -%}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Alegria editorial",
  "tag": "section",
  "class": "section-alegria-editorial",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Craftsmanship"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made slowly, by people who care"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Every Alegria piece begins with honest materials — solid timber, wool, linen and stone — shaped by makers who understand that good furniture is measured in decades, not seasons.</p>"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Our materials"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    }
  ],
  "presets": [
    {
      "name": "Alegria editorial"
    }
  ]
}
{% endschema %}
