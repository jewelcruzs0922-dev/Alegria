<style>
  #shopify-section-{{ section.id }} .alegria-rooms {
    padding: var(--alegria-space-section) 0;
  }
  #shopify-section-{{ section.id }} .alegria-rooms__head {
    display: grid;
    gap: 2rem 4rem;
    align-items: end;
    margin-bottom: clamp(3rem, 5vw, 5rem);
  }
  @media screen and (min-width: 900px) {
    #shopify-section-{{ section.id }} .alegria-rooms__head {
      grid-template-columns: 1.1fr 1fr;
    }
  }
  #shopify-section-{{ section.id }} .alegria-rooms__head h2 {
    font-size: clamp(3rem, 4.5vw, 5rem);
    margin: 0;
    line-height: 1.05;
  }
  #shopify-section-{{ section.id }} .alegria-rooms__intro {
    font-size: 1.6rem;
    line-height: 1.7;
    color: rgba(var(--color-foreground), 0.82);
    margin: 0;
    max-width: 52ch;
  }
  #shopify-section-{{ section.id }} .alegria-rooms__grid {
    display: grid;
    gap: 1.6rem;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .alegria-rooms__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
  #shopify-section-{{ section.id }} .alegria-room {
    position: relative;
    display: block;
    overflow: hidden;
    border-radius: 2px;
    color: #f5f1ea;
    aspect-ratio: 3 / 4;
  }
  #shopify-section-{{ section.id }} .alegria-room img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s ease;
  }
  #shopify-section-{{ section.id }} .alegria-room:hover img {
    transform: scale(1.04);
  }
  #shopify-section-{{ section.id }} .alegria-room__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(20, 18, 16, 0) 40%, rgba(20, 18, 16, 0.82) 100%);
  }
  #shopify-section-{{ section.id }} .alegria-room__caption {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    padding: 2.4rem;
    z-index: 2;
  }
  #shopify-section-{{ section.id }} .alegria-room__eyebrow {
    display: block;
    font-size: 1.1rem;
    letter-spacing: var(--alegria-tracking-wide);
    text-transform: uppercase;
    color: var(--alegria-gold);
    margin-bottom: 0.8rem;
  }
  #shopify-section-{{ section.id }} .alegria-room__title {
    font-family: var(--font-heading-family);
    font-size: 2.2rem;
    margin: 0 0 0.6rem;
  }
  #shopify-section-{{ section.id }} .alegria-room__text {
    font-size: 1.4rem;
    line-height: 1.55;
    color: rgba(245, 241, 234, 0.85);
    margin: 0 0 1.2rem;
  }
  #shopify-section-{{ section.id }} .alegria-room__link {
    font-size: 1.2rem;
    letter-spacing: var(--alegria-tracking-wide);
    text-transform: uppercase;
    color: var(--alegria-gold);
    border-bottom: 1px solid var(--alegria-gold);
    padding-bottom: 0.3rem;
  }
</style>

<div class="alegria-rooms color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="alegria-rooms__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="alegria-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.intro != blank -%}
        <p class="alegria-rooms__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
    </div>

    <div class="alegria-rooms__grid">
      {%- for block in section.blocks -%}
        <a
          class="alegria-room"
          {% if block.settings.link != blank %}href="{{ block.settings.link }}"{% else %}role="link" aria-disabled="true"{% endif %}
          {{ block.shopify_attributes }}
        >
          {%- if block.settings.image != blank -%}
            {{
              block.settings.image
              | image_url: width: 1400
              | image_tag:
                loading: 'lazy',
                widths: '400, 600, 900, 1200, 1400',
                sizes: '(min-width: 750px) 33vw, 100vw',
                alt: block.settings.image.alt | default: block.settings.title
            }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'alegria-room__placeholder' }}
          {%- endif -%}
          <span class="alegria-room__scrim" aria-hidden="true"></span>
          <div class="alegria-room__caption">
            {%- if block.settings.eyebrow != blank -%}
              <span class="alegria-room__eyebrow">{{ block.settings.eyebrow }}</span>
            {%- endif -%}
            <p class="alegria-room__title">{{ block.settings.title }}</p>
            {%- if block.settings.text != blank -%}
              <p class="alegria-room__text">{{ block.settings.text }}</p>
            {%- endif -%}
            {%- if block.settings.link != blank -%}
              <span class="alegria-room__link">{{ block.settings.link_label | default: 'Explore' }}</span>
            {%- endif -%}
          </div>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Alegria room inspiration",
  "tag": "section",
  "class": "section-alegria-rooms",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Room inspiration" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Rooms to live in" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Our pieces are designed to sit together as easily as they stand alone. Explore three ways to bring Alegria into a room — a reading corner, a dining room and a small living space." },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "blocks": [
    {
      "type": "room",
      "name": "Room",
      "limit": 3,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Room" },
        { "type": "text", "id": "title", "label": "Title", "default": "The reading corner" },
        { "type": "text", "id": "text", "label": "Text", "default": "A generous chair, a low table and warm light." },
        { "type": "url", "id": "link", "label": "Link" },
        { "type": "text", "id": "link_label", "label": "Link label", "default": "Explore" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Alegria room inspiration",
      "blocks": [{ "type": "room" }, { "type": "room" }, { "type": "room" }]
    }
  ]
}
{% endschema %}
