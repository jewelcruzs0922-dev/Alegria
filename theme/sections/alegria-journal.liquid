<style>
  #shopify-section-{{ section.id }} .alegria-journal {
    padding: var(--alegria-space-section) 0;
  }
  #shopify-section-{{ section.id }} .alegria-journal__head {
    display: grid;
    gap: 1.6rem 4rem;
    align-items: end;
    margin-bottom: clamp(3.2rem, 5vw, 5rem);
  }
  @media screen and (min-width: 900px) {
    #shopify-section-{{ section.id }} .alegria-journal__head {
      grid-template-columns: 1.2fr 1fr;
    }
  }
  #shopify-section-{{ section.id }} .alegria-journal__head h2 {
    font-size: clamp(3rem, 4.4vw, 4.8rem);
    margin: 0;
    line-height: 1.05;
  }
  #shopify-section-{{ section.id }} .alegria-journal__intro {
    font-size: 1.6rem;
    line-height: 1.7;
    color: rgba(var(--color-foreground), 0.8);
    margin: 0;
    max-width: 52ch;
  }
  #shopify-section-{{ section.id }} .alegria-journal__grid {
    display: grid;
    gap: 2.4rem;
  }
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .alegria-journal__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  #shopify-section-{{ section.id }} .alegria-post {
    display: flex;
    flex-direction: column;
    color: inherit;
  }
  #shopify-section-{{ section.id }} .alegria-post__media {
    overflow: hidden;
    border-radius: 2px;
    aspect-ratio: 4 / 3;
    background: rgba(var(--color-foreground), 0.06);
  }
  #shopify-section-{{ section.id }} .alegria-post__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s ease;
  }
  #shopify-section-{{ section.id }} .alegria-post:hover .alegria-post__media img {
    transform: scale(1.04);
  }
  #shopify-section-{{ section.id }} .alegria-post__meta {
    font-size: 1.2rem;
    letter-spacing: var(--alegria-tracking-wide);
    text-transform: uppercase;
    color: var(--alegria-gold);
    margin: 2rem 0 1rem;
  }
  #shopify-section-{{ section.id }} .alegria-post__title {
    font-family: var(--font-heading-family);
    font-size: 2.2rem;
    line-height: 1.25;
    margin: 0 0 1.2rem;
  }
  #shopify-section-{{ section.id }} .alegria-post:hover .alegria-post__title {
    color: var(--alegria-gold);
  }
  #shopify-section-{{ section.id }} .alegria-post__excerpt {
    font-size: 1.5rem;
    line-height: 1.65;
    color: rgba(var(--color-foreground), 0.78);
    margin: 0 0 1.6rem;
    flex: 1;
  }
  #shopify-section-{{ section.id }} .alegria-post__more {
    font-size: 1.2rem;
    letter-spacing: var(--alegria-tracking-wide);
    text-transform: uppercase;
    color: var(--alegria-gold);
    border-bottom: 1px solid var(--alegria-gold);
    padding-bottom: 0.3rem;
    align-self: flex-start;
  }
  #shopify-section-{{ section.id }} .alegria-journal__all {
    display: inline-block;
    margin-top: clamp(3rem, 4vw, 4.4rem);
    font-size: 1.3rem;
    letter-spacing: var(--alegria-tracking-wide);
    text-transform: uppercase;
    color: var(--alegria-gold);
    border-bottom: 1px solid var(--alegria-gold);
    padding-bottom: 0.4rem;
  }
</style>

<div class="alegria-journal color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="alegria-journal__head">
      <div>
        {%- if section.settings.eyebrow != blank -%}
          <span class="alegria-eyebrow">{{ section.settings.eyebrow }}</span>
        {%- endif -%}
        <h2>{{ section.settings.heading }}</h2>
      </div>
      {%- if section.settings.intro != blank -%}
        <p class="alegria-journal__intro">{{ section.settings.intro }}</p>
      {%- endif -%}
    </div>

    <div class="alegria-journal__grid">
      {%- if section.settings.blog != blank and section.settings.blog.articles_count > 0 -%}
        {%- for article in section.settings.blog.articles limit: section.settings.posts_to_show -%}
          <a class="alegria-post" href="{{ article.url }}">
            <div class="alegria-post__media">
              {%- if article.image -%}
                {{
                  article.image
                  | image_url: width: 900
                  | image_tag:
                    loading: 'lazy',
                    widths: '300, 450, 600, 900',
                    sizes: '(min-width: 750px) 33vw, 100vw',
                    alt: article.image.alt | default: article.title
                }}
              {%- endif -%}
            </div>
            <p class="alegria-post__meta">{{ article.published_at | date: '%b %d, %Y' }}</p>
            <p class="alegria-post__title">{{ article.title }}</p>
            <p class="alegria-post__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
            <span class="alegria-post__more">Read the story</span>
          </a>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <div class="alegria-post">
            <div class="alegria-post__media">{{ 'lifestyle-1' | placeholder_svg_tag: 'alegria-post__placeholder' }}</div>
            <p class="alegria-post__meta">Journal</p>
            <p class="alegria-post__title">Select a blog in the theme editor</p>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>

    {%- if section.settings.show_view_all and section.settings.blog != blank -%}
      <a class="alegria-journal__all" href="{{ section.settings.blog.url }}">Read the journal</a>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Alegria journal",
  "tag": "section",
  "class": "section-alegria-journal",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Journal" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Notes on living well" },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Stories on materials, craft and the slow business of making rooms worth staying in." },
    { "type": "blog", "id": "blog", "label": "Blog" },
    { "type": "range", "id": "posts_to_show", "label": "Posts to show", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "checkbox", "id": "show_view_all", "label": "Show 'read the journal' link", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-1" }
  ],
  "presets": [
    { "name": "Alegria journal" }
  ]
}
{% endschema %}
